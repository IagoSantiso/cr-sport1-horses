{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "78rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "navy", "name": "Azul marino", "color": "#00183b" },
				{ "slug": "navy-2", "name": "Azul marino claro", "color": "#0f2d59" },
				{ "slug": "blue", "name": "Azul", "color": "#355e9c" },
				{ "slug": "sky", "name": "Azul cielo", "color": "#adc7fc" },
				{ "slug": "ink", "name": "Texto", "color": "#1a1c1e" },
				{ "slug": "muted", "name": "Texto secundario", "color": "#44474f" },
				{ "slug": "line", "name": "Línea", "color": "#c4c6d0" },
				{ "slug": "soft", "name": "Fondo suave", "color": "#f3f3f6" },
				{ "slug": "paper", "name": "Fondo", "color": "#f9f9fc" },
				{ "slug": "white", "name": "Blanco", "color": "#ffffff" },
				{ "slug": "earth", "name": "Tierra", "color": "#1e1813" },
				{ "slug": "sand", "name": "Arena", "color": "#ede0d7" }
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Playfair Display",
					"fontFamily": "\"Playfair Display\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Playfair Display", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/playfair-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Playfair Display", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/playfair-latin-ext.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" },
						{ "fontFamily": "Playfair Display", "fontStyle": "italic", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/playfair-italic-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Playfair Display", "fontStyle": "italic", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/playfair-italic-latin-ext.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" }
					]
				},
				{
					"slug": "sans",
					"name": "Plus Jakarta Sans",
					"fontFamily": "\"Plus Jakarta Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Plus Jakarta Sans", "fontStyle": "normal", "fontWeight": "300 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/jakarta-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Plus Jakarta Sans", "fontStyle": "normal", "fontWeight": "300 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/jakarta-latin-ext.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF" }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Pequeño", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Normal", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Grande", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Muy grande", "size": "2.5rem", "fluid": { "min": "1.9rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "Titular", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 6rem)" }
			]
		},
		"border": {
			"radius": false
		},
		"shadow": {
			"defaultPresets": false
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2.5rem)",
				"right": "clamp(1rem, 4vw, 2.5rem)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--blue)" },
				":hover": { "color": { "text": "var(--wp--preset--color--navy)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--navy)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "400",
					"lineHeight": "1.12",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "1.5rem" } },
			"h4": { "typography": { "fontSize": "1.25rem" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--navy-2)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "0" },
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "1.6rem", "right": "1.6rem" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.75rem",
					"fontWeight": "700",
					"letterSpacing": "0.16em",
					"textTransform": "uppercase",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--navy)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			}
		}
	}
}
